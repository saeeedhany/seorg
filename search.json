---
layout: null
permalink: /search.json
sitemap: false
---
[{% for m in site.data.course %}{% assign mi = forloop.index %}{% for id in m.lessons %}{% assign l = site.lessons | where: "slug", id | first %}{"kind":"Lesson","title":{{ l.title | jsonify }},"summary":{{ l.description | truncatewords: 22 | jsonify }},"url":{{ l.url | jsonify }},"text":{{ l.content | strip_html | strip_newlines | truncatewords: 400 | jsonify }}},{% endfor %}{% endfor %}{% for t in site.data.glossary %}{"kind":"Glossary","title":{{ t.term | jsonify }},"summary":{{ t.def | jsonify }},"url":{{ t.term | slugify | prepend: '/glossary/#' | jsonify }},"text":{{ t.def | jsonify }}},{% endfor %}{% for c in site.data.checklists %}{"kind":"Checklist","title":{{ c.title | jsonify }},"summary":{{ c.intro | jsonify }},"url":{{ '/checklists/#' | append: c.id | jsonify }},"text":""}{% unless forloop.last %},{% endunless %}{% endfor %}]
